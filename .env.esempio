# Copia in .env e sistema per la macchina. Il .env NON va in git.
# vuoto = nome host
NOME_MACCHINA=
# 127.0.0.1 finché non c'è un'uscita pubblica decisa
ASCOLTA_HOST=127.0.0.1
ASCOLTA_PORTA=63200
# nomi con cui si arriva al connettore (controllo Host)
NOMI_HOST=127.0.0.1,localhost
# uno o più, separati da virgola
LLM_URLS=http://127.0.0.1:10400
CONNETTORE_UID=10110
# getent group systemd-journal
GRUPPO_JOURNAL=999
# per l'https diretto: percorsi DENTRO il container
# indirizzo pubblico per l'OAuth (vuoto = https://<primo nome di NOMI_HOST>:<porta> se c'è il certificato)
INDIRIZZO_PUBBLICO=
TLS_CERT=
TLS_KEY=
# ogni quanti minuti gira il raccoglitore e a che secondo (non allo scoccare del minuto). Poi rilanciare installa/installa-raccoglitore.sh
RACCOLTA_OGNI_MINUTI=5
RACCOLTA_AL_SECONDO=15
